{
  "name": "Pixel Hockey",
  "short_name": "Pixel Hockey",
  "description": "Retro pixel-art ice hockey with all 32 NHL teams.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
